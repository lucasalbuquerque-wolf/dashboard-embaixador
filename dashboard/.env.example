# Copie para .env.local e preencha. Variáveis VITE_* vão para o BUNDLE público —
# NUNCA coloque aqui a chave secreta do Supabase nem senhas.

# Supabase — URL e chave ANON/publishable (públicas por natureza).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chave da Anthropic para o assistente.
# ⚠️ DEV/LOCAL só seu: pode preencher aqui (chamada direta do browser).
# ⚠️ DEPLOY PÚBLICO: NÃO preencher — a chave iria no bundle público e vazaria.
#    Em produção, deixe vazio e configure VITE_AI_PROXY_URL apontando para a Edge Function.
VITE_ANTHROPIC_API_KEY=

# URL de um proxy server-side para a Anthropic (Supabase Edge Function), usado em produção.
# Se definido, o assistente chama o proxy (a chave fica no servidor) em vez de ir direto.
VITE_AI_PROXY_URL=
