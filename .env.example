# Copie para .env e preencha. NÃO coloque segredos reais aqui.
# Este .env é do SYNC (backend). O frontend usa dashboard/.env.example.

# --- Customer.io (App API, leitura) ---------------------------------
CUSTOMERIO_APP_API_KEY=
CUSTOMERIO_WORKSPACE_ID=115729
CUSTOMERIO_REGION=us
CUSTOMERIO_APP_API_BASE=https://api.customer.io

# --- Pipedrive ------------------------------------------------------
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
PIPEDRIVE_API_BASE=https://umbler.pipedrive.com/api/v1

# --- Supabase -------------------------------------------------------
SUPABASE_URL=
# SECRET (service role): IGNORA o RLS. Só o sync/backend. NUNCA no frontend/VITE_.
SUPABASE_SECRET_KEY=
# PUBLISHABLE (anon): pública. É a mesma que vai em dashboard/.env.local como VITE_SUPABASE_ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=
# Senha do Postgres (acesso direto). Só o backend. Nunca no frontend.
SUPABASE_DB_PASSWORD=

# Recorte padrão do dashboard (marca in_window; ingere tudo).
DASHBOARD_CUTOFF=2026-01-01
